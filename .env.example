# ==============================================================================
# Paleo-Scanner Environment Variables Configuration
# Copy this file to .env to override default port mappings and runtime settings
# ==============================================================================

# Host port mappings (change if 8000 or 4200 are already in use on your machine)
BACKEND_PORT=8000
FRONTEND_PORT=4200

# Python and Machine Learning runtime flags
PYTHONUNBUFFERED=1
TF_USE_LEGACY_KERAS=1
